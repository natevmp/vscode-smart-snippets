{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/natevmp/vscode-smart-snippets/main/schemas/smart-snippets.schema.json",
  "title": "Smart Snippets",
  "description": "Native-style VS Code snippets with computed placeholders.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/snippet"
  },
  "$defs": {
    "stringOrStringArray": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\s,]"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\s,]"
          }
        }
      ]
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "body"
      ],
      "properties": {
        "prefix": {
          "$ref": "#/$defs/stringOrStringArray",
          "description": "One or more completion prefixes."
        },
        "body": {
          "description": "A native VS Code snippet body. Use one unescaped ${pad} immediately after the first editable tab stop for dynamic padding.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "string",
                "maxLength": 100000
              }
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope",
          "description": "Language IDs, either as an array or a comma-separated string. Omit for all languages."
        },
        "pad": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fill",
            "targetWidth"
          ],
          "properties": {
            "fill": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1,
              "pattern": "^[^\\r\\n\\t]$",
              "description": "One UTF-16 code unit used as padding."
            },
            "targetWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "description": "Desired final line length in UTF-16 code units."
            }
          }
        }
      }
    }
  }
}
