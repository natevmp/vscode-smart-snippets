{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/natevmp/vscode-smart-snippets/main/schemas/smart-snippets.schema.json",
  "title": "Smart Snippets",
  "description": "Native-style VS Code snippets with computed placeholders.",
  "type": "object",
  "propertyNames": {
    "maxLength": 256
  },
  "additionalProperties": {
    "$ref": "#/$defs/snippet"
  },
  "$defs": {
    "stringOrStringArray": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "[^\\s,]"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "[^\\s,]"
          }
        }
      ]
    },
    "padConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fill",
        "targetWidth"
      ],
      "properties": {
        "fill": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "description": "A non-empty string repeated and truncated to fill the target width. Tabs and newlines are not allowed."
        },
        "targetWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Desired final line length in UTF-16 code units."
        }
      }
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "body"
      ],
      "properties": {
        "prefix": {
          "$ref": "#/$defs/stringOrStringArray",
          "description": "One or more completion prefixes."
        },
        "body": {
          "description": "A native VS Code snippet body. An active ${pad} or ${pad:name} token must end its source line and uses the nearest preceding positive numeric tab stop on that line as its driver. Up to 128 active pad tokens are allowed.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "string",
                "maxLength": 100000
              }
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/scope",
          "description": "Language IDs, either as an array or comma-separated strings. Omit for all languages. Runtime validation allows at most 256 non-empty IDs and 4,096 aggregate UTF-16 code units per snippet."
        },
        "pad": {
          "$ref": "#/$defs/padConfiguration",
          "description": "Configuration used by unescaped ${pad} tokens."
        },
        "pads": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/padConfiguration"
          },
          "description": "Named configurations used by matching unescaped ${pad:name} tokens."
        }
      }
    }
  }
}
